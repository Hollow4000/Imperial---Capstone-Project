# RL helpers
# -----------------------------
def compute_recent_improvement(y, recent_window=4):
    """
    Simple progress signal:
    compare best of last window to best before that.
    """
    n = len(y)
    if n <= recent_window:
        return 0.0
    y = np.asarray(y)
    recent_best = np.max(y[-recent_window:])
    past_best = np.max(y[:-recent_window]) if n > recent_window else np.max(y)
    return float(recent_best - past_best)

def infer_rl_state(noise_norm, recent_improvement, cluster_k, pca_structure_strength):
    """
    Very lightweight MDP-style state abstraction.
    """
    if recent_improvement > 0 and noise_norm < 0.15:
        progress_state = "improving_low_noise"
    elif recent_improvement > 0:
        progress_state = "improving_noisy"
    elif noise_norm > 0.20:
        progress_state = "stalled_high_noise"
    else:
        progress_state = "stalled_low_noise"

    structure_state = "structured" if (cluster_k > 1 or pca_structure_strength > 0.55) else "weak_structure"
    return f"{progress_state}|{structure_state}"

def load_q_values(func_id):
    path = ARTIFACTS_DIR / f"function_{func_id}" / "q_values.json"
    if path.exists():
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    return {a: 0.0 for a in RL_CONFIG["actions"]}

def save_q_values(func_id, q_values):
    path = ARTIFACTS_DIR / f"function_{func_id}" / "q_values.json"
    save_json(q_values, path)

def update_q_values(q_values, action, reward):
    alpha_q = RL_CONFIG["alpha_q"]
    gamma_q = RL_CONFIG["gamma_q"]
    current = q_values.get(action, 0.0)
    target = reward + gamma_q * max(q_values.values())
    q_values[action] = (1 - alpha_q) * current + alpha_q * target
    return q_values

def choose_action_epsilon_greedy(q_values, epsilon, rng):
    actions = list(q_values.keys())
    if rng.uniform() < epsilon:
        return rng.choice(actions), "explore"
    best = max(actions, key=lambda a: q_values[a])
    return best, "exploit"

def build_candidate_set_by_action(action, X, y, scaler, pca, cluster_centroids, cluster_stats,
                                  n_candidates, local_frac, local_noise, dim, seed):
    """
    Each action corresponds to a different sampling policy.
    """
    n_local = int(n_candidates * local_frac)
    n_global = n_candidates - n_local

    X_global = sobol_candidates(n_global, dim, seed)
    locals_list = []

    if action == "global_only":
        return X_global, {"n_global": int(n_global), "n_local": 0}

    if action == "cluster_local":
        if cluster_centroids is None:
            return X_global, {"n_global": int(n_global), "n_local": 0}

        perf = np.array([cs["best_y"] for cs in cluster_stats], dtype=float)
        perf = (perf - perf.min()) / (perf.max() - perf.min() + 1e-12)
        weights = perf / (perf.sum() + 1e-12)

        alloc = np.maximum(1, (weights * n_local).astype(int))
        while alloc.sum() > n_local:
            alloc[np.argmax(alloc)] -= 1
        while alloc.sum() < n_local:
            alloc[np.argmax(weights)] += 1

        for j in range(len(cluster_centroids)):
            locals_list.append(local_candidates(cluster_centroids[j], int(alloc[j]), seed + 1000 + j, local_noise))

    elif action == "pca_local":
        # around top observed points using PCA-shaped local moves
        m = min(3, len(y))
        top_idx = np.argsort(-y)[:m]
        weights = softmax(y[top_idx], temp=0.25)

        alloc = np.maximum(1, (weights * n_local).astype(int))
        while alloc.sum() > n_local:
            alloc[np.argmax(alloc)] -= 1
        while alloc.sum() < n_local:
            alloc[np.argmax(weights)] += 1

        for j, idx in enumerate(top_idx):
            locals_list.append(
                anisotropic_local_candidates(
                    X[idx], scaler=scaler, pca=pca, n=int(alloc[j]), seed=seed + 2000 + j, base_noise=local_noise
                )
            )

    elif action == "hybrid_cluster_pca":
        if cluster_centroids is None:
            # fallback to PCA local
            m = min(3, len(y))
            top_idx = np.argsort(-y)[:m]
            weights = softmax(y[top_idx], temp=0.25)

            alloc = np.maximum(1, (weights * n_local).astype(int))
            while alloc.sum() > n_local:
                alloc[np.argmax(alloc)] -= 1
            while alloc.sum() < n_local:
                alloc[np.argmax(weights)] += 1

            for j, idx in enumerate(top_idx):
                locals_list.append(
                    anisotropic_local_candidates(
                        X[idx], scaler=scaler, pca=pca, n=int(alloc[j]), seed=seed + 3000 + j, base_noise=local_noise
                    )
                )
        else:
            perf = np.array([cs["best_y"] for cs in cluster_stats], dtype=float)
            perf = (perf - perf.min()) / (perf.max() - perf.min() + 1e-12)

            counts = np.array([cs["n_points"] for cs in cluster_stats], dtype=float)
            inv_counts = 1.0 / (counts + 1e-6)
            inv_counts = inv_counts / (inv_counts.sum() + 1e-12)

            weights = 0.7 * perf + 0.3 * inv_counts
            weights = weights / (weights.sum() + 1e-12)

            alloc = np.maximum(1, (weights * n_local).astype(int))
            while alloc.sum() > n_local:
                alloc[np.argmax(alloc)] -= 1
            while alloc.sum() < n_local:
                alloc[np.argmax(weights)] += 1

            for j in range(len(cluster_centroids)):
                locals_list.append(
                    anisotropic_local_candidates(
                        cluster_centroids[j],
                        scaler=scaler,
                        pca=pca,
                        n=int(alloc[j]),
                        seed=seed + 4000 + j,
                        base_noise=local_noise
                    )
                )

    X_local = np.vstack(locals_list) if locals_list else np.empty((0, dim))
    X_cand = np.vstack([X_global, X_local]) if len(X_local) else X_global
    X_cand = np.clip(X_cand, 0.0, 1.0 - CLIP_EPS)
    return X_cand, {"n_global": int(n_global), "n_local": int(X_local.shape[0])}


# -----------------------------
# Decoding helper
# -----------------------------
def decode_choice(scores, rng, temperature, top_p, top_k):
    probs = softmax(scores, temp=max(temperature, 1e-6))

    order = np.argsort(-probs)
    probs_sorted = probs[order]

    k = min(int(top_k), len(order))
    order = order[:k]
    probs_sorted = probs_sorted[:k]

    cdf = np.cumsum(probs_sorted)
    cutoff = int(np.searchsorted(cdf, top_p))
    cutoff = int(np.clip(cutoff, 0, len(probs_sorted) - 1))
    keep = cutoff + 1

    order = order[:keep]
    probs_keep = probs_sorted[:keep]
    probs_keep = probs_keep / (np.sum(probs_keep) + 1e-12)

    return int(rng.choice(order, p=probs_keep))


# -----------------------------
# Main suggestion engine
# -----------------------------
def kernel_ucb_suggest(X, y, dim, kappa_base, n_candidates_base, seed, func_id=None):
    rng = np.random.default_rng(seed)

    n_obs = X.shape[0]
    scaler = StandardScaler()
    Xs = scaler.fit_transform(X)

    # 1) Tune surrogate
    tuned = tune_krr_hyperparams(Xs, y, seed=seed)
    alpha_star, gamma_star = tuned["alpha"], tuned["gamma"]

    # 2) Noise proxy
    noise_proxy = estimate_noise_level(Xs, y, alpha_star, gamma_star, seed=seed)
    noise_norm = noise_proxy / (noise_proxy + 1.0)

    # 3) PCA structure
    pca, pca_evr, pca_cum, pca_n_keep = fit_pca_structure(
        Xs,
        variance_threshold=DECODER["pca_variance_threshold"],
        max_components=DECODER["pca_max_components"]
    )

    pca_structure_strength = 0.0 if pca_evr is None else float(np.sum(pca_evr))

    # 4) Clustering
    cluster_k, cluster_labels, sil = pick_k_via_silhouette(
        Xs,
        k_min=DECODER["cluster_k_min"],
        k_max=DECODER["cluster_k_max"]
    )
    cluster_centroids = None
    cluster_stats = None
    if cluster_k > 1 and cluster_labels is not None:
        cluster_centroids, cluster_stats = compute_cluster_stats(X, y, scaler, cluster_labels)

    # 5) RL-style state and adaptive epsilon
    recent_improvement = compute_recent_improvement(y, recent_window=RL_CONFIG["recent_window"])
    rl_state = infer_rl_state(noise_norm, recent_improvement, cluster_k, pca_structure_strength)

    # If recent progress is poor or noise is high -> more exploration
    epsilon = RL_CONFIG["epsilon_base"] + 0.10 * float(recent_improvement <= 0) + 0.08 * noise_norm
    epsilon = float(np.clip(epsilon, RL_CONFIG["epsilon_min"], RL_CONFIG["epsilon_max"]))

    q_values = load_q_values(func_id) if func_id is not None else {a: 0.0 for a in RL_CONFIG["actions"]}
    action, action_mode = choose_action_epsilon_greedy(q_values, epsilon, rng)

    # 6) Scale budgets
    scale_with_data = np.clip((n_obs - 10) / 12.0, 0.0, 1.0)

    n_candidates = int(np.clip(
        n_candidates_base * (
            1.0
            + 0.20 * scale_with_data
            + 0.20 * noise_norm
            + 0.10 * pca_structure_strength
        ),
        8000,
        70000
    ))

    ENSEMBLE_B = int(np.clip(
        BASE_ENSEMBLE_B + 6 * scale_with_data + 8 * noise_norm + 4 * pca_structure_strength,
        10,
        30
    ))

    LOCAL_FRAC = float(np.clip(
        BASE_LOCAL_FRAC + 0.05 * pca_structure_strength - 0.10 * noise_norm,
        0.18,
        0.48
    ))

    LOCAL_NOISE = float(np.clip(
        BASE_LOCAL_NOISE + 0.04 * noise_norm - 0.03 * pca_structure_strength,
        0.04,
        0.16
    ))

    # Final round -> slightly more exploit if recent improvement exists
    kappa = float(np.clip(
        kappa_base + 0.8 * noise_norm - 0.30 * scale_with_data - 0.20 * pca_structure_strength - 0.10 * max(recent_improvement, 0.0),
        0.7,
        4.0
    ))

    temperature = float(np.clip(
        DECODER["temperature_base"] + 0.30 * noise_norm - 0.25 * scale_with_data - 0.18 * pca_structure_strength,
        0.20,
        0.95
    ))

    top_p = float(np.clip(
        DECODER["top_p_base"] + 0.08 * noise_norm - 0.05 * scale_with_data - 0.03 * pca_structure_strength,
        0.05,
        0.25
    ))

    top_k = int(np.clip(
        DECODER["top_k_base"] + 220 * noise_norm + 100 * (1 - scale_with_data) - 90 * pca_structure_strength,
        80,
        800
    ))

    risk_lambda = float(np.clip(
        DECODER["risk_lambda_base"] + 0.24 * scale_with_data,
        0.25,
        0.80
    ))

    # 7) Candidate generation via RL-selected action
    X_cand, action_alloc = build_candidate_set_by_action(
        action=action,
        X=X,
        y=y,
        scaler=scaler,
        pca=pca,
        cluster_centroids=cluster_centroids,
        cluster_stats=cluster_stats,
        n_candidates=n_candidates,
        local_frac=LOCAL_FRAC,
        local_noise=LOCAL_NOISE,
        dim=dim,
        seed=seed
    )
    Xc = scaler.transform(X_cand)

    # 8) Ensemble surrogate predictions
    preds = np.zeros((ENSEMBLE_B, Xc.shape[0]), dtype=float)
    n = Xs.shape[0]

    for b in range(ENSEMBLE_B):
        idx = rng.integers(0, n, size=n)
        model = KernelRidge(kernel="rbf", alpha=alpha_star, gamma=gamma_star)
        model.fit(Xs[idx], y[idx])
        preds[b] = model.predict(Xc)

    mu = preds.mean(axis=0)
    sigma = preds.std(axis=0)

    # 9) Auxiliary signals
    dists = np.min(np.linalg.norm(Xc[:, None, :] - Xs[None, :, :], axis=2), axis=1)
    dists_norm = dists / (dists.max() + 1e-12)

    edge_pen = boundary_penalty(X_cand)
    edge_pen = edge_pen / (edge_pen.max() + 1e-12)

    aligned_energy, residual_energy = pca_candidate_features(Xc, pca)

    # 10) UCB
    ucb = mu + kappa * (0.85 * sigma + 0.15 * dists_norm)

    # 11) Risk-adjusted score
    risk_adjusted = (
        ucb
        - risk_lambda * sigma
        - DECODER["dist_lambda"] * dists_norm
        - DECODER["edge_lambda"] * edge_pen
        + DECODER["pca_alignment_bonus"] * aligned_energy
        - DECODER["pca_residual_penalty"] * residual_energy
    )

    target_cluster_id = None
    target_reason = None
    dist_to_target_centroid = None

    if cluster_centroids is not None:
        cent_s = scaler.transform(cluster_centroids)
        dist_mat = np.linalg.norm(Xc[:, None, :] - cent_s[None, :, :], axis=2)
        nearest = dist_mat.argmin(axis=1)
        nearest_dist = dist_mat.min(axis=1)

        counts = np.array([cs["n_points"] for cs in cluster_stats], dtype=float)
        inv = 1.0 / (counts + 1e-6)
        cluster_bonus = inv[nearest]
        cluster_bonus = cluster_bonus / (cluster_bonus.max() + 1e-12)

        risk_adjusted = risk_adjusted + DECODER["cluster_bonus"] * cluster_bonus
    else:
        nearest = None
        nearest_dist = None

    # 12) shortlist decoding
    best_of = int(np.clip(DECODER["best_of"], 4, 20))
    sampled = [decode_choice(ucb, rng, temperature, top_p, top_k) for _ in range(best_of)]
    sampled = np.unique(sampled)

    chosen_idx = int(sampled[np.argmax(risk_adjusted[sampled])])
    x_next = np.clip(X_cand[chosen_idx], 0.0, 1.0 - CLIP_EPS)

    # 13) Interpretability
    if cluster_centroids is not None and nearest is not None:
        target_cluster_id = int(nearest[chosen_idx])
        dist_to_target_centroid = float(nearest_dist[chosen_idx])

        chosen_count = cluster_stats[target_cluster_id]["n_points"]
        min_count = min(cs["n_points"] for cs in cluster_stats)
        if chosen_count == min_count:
            target_reason = "exploration: under-sampled cluster"
        else:
            target_reason = "exploitation: high-performing cluster region"

    # 14) Q-update proxy reward
    # Since final round has no immediate portal reward yet, use model-based proxy:
    # reward = predicted uplift above current best, discounted by uncertainty
    current_best = float(np.max(y))
    proxy_reward = float((mu[chosen_idx] - current_best) - 0.5 * sigma[chosen_idx])

    if func_id is not None:
        q_values = update_q_values(q_values, action, proxy_reward)
        save_q_values(func_id, q_values)

    debug = {
        "n_obs": int(n_obs),
        "n_candidates_used": int(n_candidates),
        "alpha": float(alpha_star),
        "gamma": float(gamma_star),
        "cv_mse": float(tuned["cv_mse"]),
        "noise_proxy": float(noise_proxy),
        "noise_norm": float(noise_norm),

        "ENSEMBLE_B": int(ENSEMBLE_B),
        "LOCAL_FRAC": float(LOCAL_FRAC),
        "LOCAL_NOISE": float(LOCAL_NOISE),
        "kappa_used": float(kappa),
        "temperature": float(temperature),
        "top_p": float(top_p),
        "top_k": int(top_k),
        "best_of": int(best_of),
        "risk_lambda": float(risk_lambda),

        # clustering
        "cluster_k": int(cluster_k),
        "cluster_silhouette": None if sil is None else float(sil),
        "cluster_summary": cluster_stats,
        "target_cluster_id": target_cluster_id,
        "target_reason": target_reason,
        "dist_to_target_centroid_scaled": dist_to_target_centroid,

        # PCA
        "pca_n_components": None if pca_n_keep is None else int(pca_n_keep),
        "pca_explained_variance_ratio": None if pca_evr is None else [float(v) for v in pca_evr],
        "pca_cumulative_variance": None if pca_cum is None else [float(v) for v in pca_cum],
        "pca_structure_strength": float(pca_structure_strength),
        "chosen_alignment_energy": float(aligned_energy[chosen_idx]),
        "chosen_residual_energy": float(residual_energy[chosen_idx]),

        # RL / bandit
        "rl_state": rl_state,
        "epsilon": float(epsilon),
        "policy_action": action,
        "policy_mode": action_mode,
        "policy_q_values": q_values,
        "proxy_reward": float(proxy_reward),
        "recent_improvement": float(recent_improvement),

        # action allocation
        "action_allocation": action_alloc,
    }

    return x_next, debug


