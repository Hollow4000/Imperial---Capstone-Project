# -----------------------------
# File helpers
# -----------------------------
def now_utc_iso():
    return dt.datetime.utcnow().replace(microsecond=0).isoformat() + "Z"

def save_json(obj, path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(obj, f, indent=2, sort_keys=True)

def save_text(text, path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)


# -----------------------------
# Utilities
# -----------------------------
def format_query(x):
    x = np.clip(x, 0.0, 1.0 - CLIP_EPS)
    return "-".join(f"{float(v):.6f}" for v in x)

def sobol_candidates(n, dim, seed):
    m = int(np.ceil(np.log2(max(n, 2))))
    sampler = qmc.Sobol(d=dim, scramble=True, seed=seed)
    X = sampler.random(n=2**m)
    return X[:n]

def local_candidates(x_center, n, seed, noise):
    rng = np.random.default_rng(seed)
    X = x_center[None, :] + rng.normal(0.0, noise, size=(n, x_center.size))
    return np.clip(X, 0.0, 1.0 - CLIP_EPS)

def softmax(z, temp=1.0):
    z = (z - np.max(z)) / max(temp, 1e-12)
    e = np.exp(z)
    return e / (np.sum(e) + 1e-12)

def boundary_penalty(X):
    d = np.minimum(X, 1.0 - X)
    return (1.0 / (d + 1e-6)).mean(axis=1)


# -----------------------------
# Noise proxy + tuning
# -----------------------------
def estimate_noise_level(Xs, y, alpha, gamma, seed):
    n = Xs.shape[0]
    if n < 6:
        return 0.0
    kf = KFold(n_splits=min(CV_SPLITS, n), shuffle=True, random_state=seed)
    errs = []
    for tr, va in kf.split(Xs):
        model = KernelRidge(kernel="rbf", alpha=alpha, gamma=gamma)
        model.fit(Xs[tr], y[tr])
        pred = model.predict(Xs[va])
        errs.append(np.mean((pred - y[va]) ** 2))
    return float(np.mean(errs))

def tune_krr_hyperparams(Xs, y, seed):
    best = {"alpha": None, "gamma": None, "cv_mse": np.inf}
    n = Xs.shape[0]
    kf = KFold(n_splits=min(CV_SPLITS, n), shuffle=True, random_state=seed)

    for alpha in ALPHA_GRID:
        for gamma in GAMMA_GRID:
            mses = []
            for tr, va in kf.split(Xs):
                model = KernelRidge(kernel="rbf", alpha=alpha, gamma=gamma)
                model.fit(Xs[tr], y[tr])
                pred = model.predict(Xs[va])
                mses.append(np.mean((pred - y[va]) ** 2))
            cv_mse = float(np.mean(mses))
            if cv_mse < best["cv_mse"]:
                best = {"alpha": float(alpha), "gamma": float(gamma), "cv_mse": cv_mse}
    return best


# -----------------------------
# Clustering helpers
# -----------------------------
def pick_k_via_silhouette(Xs, k_min=2, k_max=6):
    n = Xs.shape[0]
    k_max = min(k_max, n - 1)
    if n < 4 or k_max < k_min:
        return 1, None, None

    best_k, best_s, best_labels = None, -np.inf, None
    for k in range(k_min, k_max + 1):
        labels = AgglomerativeClustering(n_clusters=k, linkage="ward").fit_predict(Xs)
        if len(np.unique(labels)) < 2:
            continue
        s = silhouette_score(Xs, labels)
        if s > best_s:
            best_s, best_k, best_labels = s, k, labels

    if best_k is None:
        return 1, None, None
    return int(best_k), best_labels, float(best_s)

def compute_cluster_stats(X, y, scaler, labels):
    Xs = scaler.transform(X)
    clusters = np.unique(labels)
    centroids_s = np.vstack([Xs[labels == c].mean(axis=0) for c in clusters])
    centroids = scaler.inverse_transform(centroids_s)

    stats = []
    for c in clusters:
        idx = np.where(labels == c)[0]
        yc = y[idx]
        stats.append({
            "cluster_id": int(c),
            "n_points": int(len(idx)),
            "best_y": float(np.max(yc)),
            "mean_y": float(np.mean(yc)),
            "std_y": float(np.std(yc)),
        })
    return centroids, stats


# -----------------------------
# PCA helpers
# -----------------------------
def fit_pca_structure(Xs, variance_threshold=0.90, max_components=3):
    n_obs, dim = Xs.shape
    if n_obs < 4:
        return None, None, None, None

    max_allowed = min(dim, n_obs - 1, max_components)
    if max_allowed < 1:
        return None, None, None, None

    pca_full = PCA(n_components=max_allowed)
    pca_full.fit(Xs)

    evr = pca_full.explained_variance_ratio_
    cum = np.cumsum(evr)
    n_keep = int(np.searchsorted(cum, variance_threshold) + 1)
    n_keep = min(n_keep, max_allowed)

    pca = PCA(n_components=n_keep)
    pca.fit(Xs)

    return pca, evr[:n_keep], cum[:n_keep], n_keep

def anisotropic_local_candidates(x_center, scaler, pca, n, seed, base_noise):
    """
    Sample around x_center using PCA directions to preserve structure:
    more movement along high-variance directions, less off-subspace noise.
    """
    rng = np.random.default_rng(seed)
    x_center_s = scaler.transform(x_center[None, :])[0]

    if pca is None:
        X = x_center[None, :] + rng.normal(0.0, base_noise, size=(n, x_center.size))
        return np.clip(X, 0.0, 1.0 - CLIP_EPS)

    comps = pca.components_  # (k, d)
    k = comps.shape[0]

    # bigger variance directions get bigger sampling scale
    scales = np.sqrt(np.maximum(pca.explained_variance_, 1e-8))
    scales = scales / (np.max(scales) + 1e-12)

    z = rng.normal(0.0, 1.0, size=(n, k))
    structured = (z * scales[None, :] * base_noise) @ comps

    # small isotropic residual to preserve exploration without too much randomness
    residual = rng.normal(0.0, 0.25 * base_noise, size=(n, x_center.size))

    Xs_new = x_center_s[None, :] + structured + residual
    X_new = scaler.inverse_transform(Xs_new)

    return np.clip(X_new, 0.0, 1.0 - CLIP_EPS)

def pca_candidate_features(Xc, pca):
    """
    Returns:
      aligned_energy: how much a point varies along retained PCs
      residual_energy: how far a point lies off the retained PCA subspace
    """
    if pca is None:
        zeros = np.zeros(Xc.shape[0], dtype=float)
        return zeros, zeros

    Z = pca.transform(Xc)
    Xc_recon = pca.inverse_transform(Z)

    aligned_energy = np.linalg.norm(Z, axis=1)
    residual_energy = np.linalg.norm(Xc - Xc_recon, axis=1)

    aligned_energy = aligned_energy / (aligned_energy.max() + 1e-12)
    residual_energy = residual_energy / (residual_energy.max() + 1e-12)

    return aligned_energy, residual_energy


# -----------------------------
# Decoding helper
# -----------------------------
def decode_choice(scores, rng, temperature, top_p, top_k):
    probs = softmax(scores, temp=max(temperature, 1e-6))

    order = np.argsort(-probs)
    probs_sorted = probs[order]

    k = min(int(top_k), len(order))
    order = order[:k]
    probs_sorted = probs_sorted[:k]

    cdf = np.cumsum(probs_sorted)
    cutoff = int(np.searchsorted(cdf, top_p))
    cutoff = int(np.clip(cutoff, 0, len(probs_sorted) - 1))
    keep = cutoff + 1

    order = order[:keep]
    probs_keep = probs_sorted[:keep]
    probs_keep = probs_keep / (np.sum(probs_keep) + 1e-12)

    return int(rng.choice(order, p=probs_keep))


# -----------------------------
# Main suggestion engine
# -----------------------------
def kernel_ucb_suggest(X, y, dim, kappa_base, n_candidates_base, seed):
    rng = np.random.default_rng(seed)

    n_obs = X.shape[0]
    scaler = StandardScaler()
    Xs = scaler.fit_transform(X)

    # 1) Tune surrogate
    tuned = tune_krr_hyperparams(Xs, y, seed=seed)
    alpha_star, gamma_star = tuned["alpha"], tuned["gamma"]

    # 2) Noise proxy
    noise_proxy = estimate_noise_level(Xs, y, alpha_star, gamma_star, seed=seed)
    noise_norm = noise_proxy / (noise_proxy + 1.0)

    # 3) PCA structure
    pca, pca_evr, pca_cum, pca_n_keep = fit_pca_structure(
        Xs,
        variance_threshold=DECODER["pca_variance_threshold"],
        max_components=DECODER["pca_max_components"]
    )

    if pca_evr is None:
        pca_structure_strength = 0.0
    else:
        pca_structure_strength = float(np.sum(pca_evr))

    # 4) Scale budgets with data + noise + structure
    scale_with_data = np.clip((n_obs - 10) / 12.0, 0.0, 1.0)

    n_candidates = int(np.clip(
        n_candidates_base * (
            1.0
            + 0.20 * scale_with_data
            + 0.20 * noise_norm
            + 0.10 * pca_structure_strength
        ),
        8000,
        70000
    ))

    ENSEMBLE_B = int(np.clip(
        BASE_ENSEMBLE_B + 6 * scale_with_data + 8 * noise_norm + 4 * pca_structure_strength,
        10,
        30
    ))

    # More structure -> slightly less random local fraction, more directed
    LOCAL_FRAC = float(np.clip(
        BASE_LOCAL_FRAC + 0.05 * pca_structure_strength - 0.10 * noise_norm,
        0.18,
        0.48
    ))

    # More structure -> slightly tighter local noise
    LOCAL_NOISE = float(np.clip(
        BASE_LOCAL_NOISE + 0.04 * noise_norm - 0.03 * pca_structure_strength,
        0.04,
        0.16
    ))

    kappa = float(np.clip(
        kappa_base + 0.8 * noise_norm - 0.25 * scale_with_data - 0.15 * pca_structure_strength,
        0.8,
        4.0
    ))

    # More structure and more data -> lower randomness
    temperature = float(np.clip(
        DECODER["temperature_base"] + 0.35 * noise_norm - 0.20 * scale_with_data - 0.15 * pca_structure_strength,
        0.25,
        1.00
    ))

    top_p = float(np.clip(
        DECODER["top_p_base"] + 0.10 * noise_norm - 0.04 * scale_with_data - 0.03 * pca_structure_strength,
        0.06,
        0.30
    ))

    top_k = int(np.clip(
        DECODER["top_k_base"] + 250 * noise_norm + 120 * (1 - scale_with_data) - 80 * pca_structure_strength,
        100,
        900
    ))

    risk_lambda = float(np.clip(
        DECODER["risk_lambda_base"] + 0.22 * scale_with_data,
        0.20,
        0.75
    ))

    # 5) Clustering lens
    cluster_k, cluster_labels, sil = pick_k_via_silhouette(
        Xs,
        k_min=DECODER["cluster_k_min"],
        k_max=DECODER["cluster_k_max"]
    )
    cluster_centroids = None
    cluster_stats = None
    if cluster_k > 1 and cluster_labels is not None:
        cluster_centroids, cluster_stats = compute_cluster_stats(X, y, scaler, cluster_labels)

    # 6) Candidate generation: global + local
    n_local = int(n_candidates * LOCAL_FRAC)
    n_global = n_candidates - n_local

    X_global = sobol_candidates(n_global, dim, seed)
    locals_list = []

    if n_local > 0:
        if cluster_centroids is not None:
            perf = np.array([cs["best_y"] for cs in cluster_stats], dtype=float)
            perf = (perf - perf.min()) / (perf.max() - perf.min() + 1e-12)

            counts = np.array([cs["n_points"] for cs in cluster_stats], dtype=float)
            inv_counts = 1.0 / (counts + 1e-6)
            inv_counts = inv_counts / (inv_counts.sum() + 1e-12)

            w_exploit = np.clip(
                0.58 + 0.22 * scale_with_data + 0.10 * pca_structure_strength - 0.18 * noise_norm,
                0.25,
                0.90
            )
            w_explore = 1.0 - w_exploit

            weights = w_exploit * perf + w_explore * inv_counts
            weights = weights / (weights.sum() + 1e-12)

            alloc = np.maximum(1, (weights * n_local).astype(int))
            while alloc.sum() > n_local:
                alloc[np.argmax(alloc)] -= 1
            while alloc.sum() < n_local:
                alloc[np.argmax(weights)] += 1

            for j in range(cluster_k):
                locals_list.append(
                    anisotropic_local_candidates(
                        cluster_centroids[j],
                        scaler=scaler,
                        pca=pca,
                        n=int(alloc[j]),
                        seed=seed + 3000 + j,
                        base_noise=LOCAL_NOISE
                    )
                )
        else:
            # fallback: around top observed points, PCA-aligned
            m = min(3, len(y))
            top_idx = np.argsort(-y)[:m]
            weights = softmax(y[top_idx], temp=0.25)
            alloc = np.maximum(1, (weights * n_local).astype(int))
            while alloc.sum() > n_local:
                alloc[np.argmax(alloc)] -= 1
            while alloc.sum() < n_local:
                alloc[np.argmax(weights)] += 1

            for j, idx in enumerate(top_idx):
                locals_list.append(
                    anisotropic_local_candidates(
                        X[idx],
                        scaler=scaler,
                        pca=pca,
                        n=int(alloc[j]),
                        seed=seed + 1000 + j,
                        base_noise=LOCAL_NOISE
                    )
                )

    X_local = np.vstack(locals_list) if locals_list else np.empty((0, dim))
    X_cand = np.vstack([X_global, X_local])
    X_cand = np.clip(X_cand, 0.0, 1.0 - CLIP_EPS)
    Xc = scaler.transform(X_cand)

    # 7) Ensemble surrogate predictions
    preds = np.zeros((ENSEMBLE_B, Xc.shape[0]), dtype=float)
    n = Xs.shape[0]

    for b in range(ENSEMBLE_B):
        idx = rng.integers(0, n, size=n)
        model = KernelRidge(kernel="rbf", alpha=alpha_star, gamma=gamma_star)
        model.fit(Xs[idx], y[idx])
        preds[b] = model.predict(Xc)

    mu = preds.mean(axis=0)
    sigma = preds.std(axis=0)

    # 8) Auxiliary penalties / cues
    dists = np.min(np.linalg.norm(Xc[:, None, :] - Xs[None, :, :], axis=2), axis=1)
    dists_norm = dists / (dists.max() + 1e-12)

    edge_pen = boundary_penalty(X_cand)
    edge_pen = edge_pen / (edge_pen.max() + 1e-12)

    aligned_energy, residual_energy = pca_candidate_features(Xc, pca)

    # 9) UCB acquisition
    ucb = mu + kappa * (0.85 * sigma + 0.15 * dists_norm)

    # 10) Risk-adjusted score + PCA structure terms
    risk_adjusted = (
        ucb
        - risk_lambda * sigma
        - DECODER["dist_lambda"] * dists_norm
        - DECODER["edge_lambda"] * edge_pen
        + DECODER["pca_alignment_bonus"] * aligned_energy
        - DECODER["pca_residual_penalty"] * residual_energy
    )

    target_cluster_id = None
    target_reason = None
    dist_to_target_centroid = None

    # 11) Cluster-aware nudge
    if cluster_centroids is not None:
        cent_s = scaler.transform(cluster_centroids)
        dist_mat = np.linalg.norm(Xc[:, None, :] - cent_s[None, :, :], axis=2)
        nearest = dist_mat.argmin(axis=1)
        nearest_dist = dist_mat.min(axis=1)

        counts = np.array([cs["n_points"] for cs in cluster_stats], dtype=float)
        inv = 1.0 / (counts + 1e-6)
        cluster_bonus = inv[nearest]
        cluster_bonus = cluster_bonus / (cluster_bonus.max() + 1e-12)

        risk_adjusted = risk_adjusted + DECODER["cluster_bonus"] * cluster_bonus
    else:
        nearest = None
        nearest_dist = None

    # 12) shortlist decoding
    best_of = int(np.clip(DECODER["best_of"], 3, 20))
    sampled = [decode_choice(ucb, rng, temperature, top_p, top_k) for _ in range(best_of)]
    sampled = np.unique(sampled)

    chosen_idx = int(sampled[np.argmax(risk_adjusted[sampled])])
    x_next = np.clip(X_cand[chosen_idx], 0.0, 1.0 - CLIP_EPS)

    # 13) Explanations
    if cluster_centroids is not None and nearest is not None:
        target_cluster_id = int(nearest[chosen_idx])
        dist_to_target_centroid = float(nearest_dist[chosen_idx])

        chosen_count = cluster_stats[target_cluster_id]["n_points"]
        min_count = min(cs["n_points"] for cs in cluster_stats)
        if chosen_count == min_count:
            target_reason = "exploration: under-sampled cluster"
        else:
            target_reason = "exploitation: high-performing cluster region"

    debug = {
        "n_obs": int(n_obs),
        "n_candidates_used": int(n_candidates),
        "alpha": float(alpha_star),
        "gamma": float(gamma_star),
        "cv_mse": float(tuned["cv_mse"]),
        "noise_proxy": float(noise_proxy),
        "noise_norm": float(noise_norm),

        "ENSEMBLE_B": int(ENSEMBLE_B),
        "LOCAL_FRAC": float(LOCAL_FRAC),
        "LOCAL_NOISE": float(LOCAL_NOISE),
        "kappa_used": float(kappa),
        "temperature": float(temperature),
        "top_p": float(top_p),
        "top_k": int(top_k),
        "best_of": int(best_of),
        "risk_lambda": float(risk_lambda),

        # clustering
        "cluster_k": int(cluster_k),
        "cluster_silhouette": None if sil is None else float(sil),
        "cluster_summary": cluster_stats,
        "target_cluster_id": target_cluster_id,
        "target_reason": target_reason,
        "dist_to_target_centroid_scaled": dist_to_target_centroid,

        # PCA
        "pca_n_components": None if pca_n_keep is None else int(pca_n_keep),
        "pca_explained_variance_ratio": None if pca_evr is None else [float(v) for v in pca_evr],
        "pca_cumulative_variance": None if pca_cum is None else [float(v) for v in pca_cum],
        "pca_structure_strength": float(pca_structure_strength),
        "chosen_alignment_energy": float(aligned_energy[chosen_idx]),
        "chosen_residual_energy": float(residual_energy[chosen_idx]),
    }

    return x_next, debug


# -----------------------------
# One function runner
# -----------------------------
def suggest_next_point_for_function(func_id, seed, expected_n_obs=21, round_label="Round 12"):
    cfg = FUNCTION_CONFIG[func_id]
    dim = cfg["dim"]

    folder = os.path.join(BASE_DIR, f"function_{func_id}")
    X = np.load(os.path.join(folder, "initial_inputs.npy"))
    y = np.load(os.path.join(folder, "initial_outputs.npy")).ravel()

    if X.shape[1] != dim:
        raise ValueError(f"Dim mismatch for function {func_id}: expected {dim}, got {X.shape[1]}")

    if expected_n_obs is not None and X.shape[0] != expected_n_obs:
        print(f"[WARN] Function {func_id}: expected {expected_n_obs} observations, found {X.shape[0]}")

    x_next, debug = kernel_ucb_suggest(
        X, y,
        dim=dim,
        kappa_base=cfg["kappa"],
        n_candidates_base=cfg["n_candidates"],
        seed=seed
    )

    submission = format_query(x_next)

    record = {
        "timestamp_utc": now_utc_iso(),
        "stage": "Stage 2",
        "round": round_label,
        "round_context": (
            "Preparing the next query using both clustering and PCA. "
            "The goal is to learn from structure in the search space, preserve informative variance, "
            "and reduce randomness while maintaining exploration."
        ),
        "function_id": int(func_id),
        "dim": int(dim),
        "n_obs": int(X.shape[0]),
        "candidate_budget_base": int(cfg["n_candidates"]),
        "kappa_base": float(cfg["kappa"]),
        "suggested_x": [float(v) for v in x_next.tolist()],
        "submission_string": submission,
        "debug": debug,
        "reproducibility": {
            "seed": int(seed),
            "clip_eps": float(CLIP_EPS),
            "alpha_grid": ALPHA_GRID.tolist(),
            "gamma_grid": GAMMA_GRID.tolist(),
            "cv_splits": int(CV_SPLITS),
        },
    }

    save_json(record, ARTIFACTS_DIR / f"function_{func_id}" / "run_record.json")
    return x_next, submission, debug, record


# -----------------------------
# Run all functions
# -----------------------------
def suggest_for_all_functions(expected_n_obs=21, round_label="Round 12"):
    results = {}
    debug_all = {}
    records_all = {}

    for func_id in range(1, 9):
        x_next, submission, debug, record = suggest_next_point_for_function(
            func_id=func_id,
            seed=func_id,
            expected_n_obs=expected_n_obs,
            round_label=round_label
        )

        results[func_id] = submission
        debug_all[func_id] = debug
        records_all[func_id] = record

        print(f"Function {func_id}: {submission}")
        print(f"  n_obs={debug['n_obs']}  n_candidates={debug['n_candidates_used']}  ensemble={debug['ENSEMBLE_B']}")
        print(f"  tuned alpha={debug['alpha']} gamma={debug['gamma']} cv_mse={debug['cv_mse']:.6g}")
        print(f"  noise_proxy={debug['noise_proxy']:.6g} -> kappa={debug['kappa_used']:.3f}")
        print(f"  local_frac={debug['LOCAL_FRAC']:.2f} local_noise={debug['LOCAL_NOISE']:.3f}")
        print(f"  decoder: temp={debug['temperature']:.3f} top_p={debug['top_p']:.3f} top_k={debug['top_k']} best_of={debug['best_of']}")
        print(f"  clustering: k={debug['cluster_k']} sil={debug['cluster_silhouette']} target_cluster={debug['target_cluster_id']} reason={debug['target_reason']}")
        print(f"  pca: n_components={debug['pca_n_components']} structure={debug['pca_structure_strength']:.3f} align={debug['chosen_alignment_energy']:.3f} residual={debug['chosen_residual_energy']:.3f}")
        print()

    save_json(
        {"timestamp_utc": now_utc_iso(), "results": results, "records": records_all},
        ARTIFACTS_DIR / "stage2_round12_next_queries.json"
    )

    lines = [f"Function {fid}: {q}" for fid, q in results.items()]
    save_text("\n".join(lines) + "\n", ARTIFACTS_DIR / "submission_strings.txt")

    return results, debug_all, records_all


def make_reflection_snippet(record):
    d = record["debug"]

    cluster_line = ""
    if d.get("cluster_k", 1) > 1 and d.get("target_cluster_id") is not None:
        cluster_line = (
            f" We identified k={d['cluster_k']} clusters in the observed points (silhouette={d['cluster_silhouette']:.3f}) "
            f"and targeted cluster {d['target_cluster_id']} because it reflected {d['target_reason']}."
            f" The chosen point sits at a scaled distance of {d['dist_to_target_centroid_scaled']:.3f} from that cluster centroid."
        )

    pca_line = ""
    if d.get("pca_n_components") is not None:
        evr = d["pca_explained_variance_ratio"]
        pca_line = (
            f" PCA retained {d['pca_n_components']} principal directions with explained variance ratios "
            f"{[round(v, 3) for v in evr]}. "
            f"This query was biased toward informative directions (alignment={d['chosen_alignment_energy']:.3f}) "
            f"while avoiding off-structure randomness (residual={d['chosen_residual_energy']:.3f})."
        )

    return (
        f"Function {record['function_id']} (d={record['dim']}): We used an RBF Kernel Ridge surrogate with CV-tuned "
        f"alpha={d['alpha']}, gamma={d['gamma']} (CV MSE={d['cv_mse']:.4g}). With {d['n_obs']} observations, "
        f"noise_proxy={d['noise_proxy']:.4g} set exploration kappa={d['kappa_used']:.2f}. "
        f"Candidates were generated via Sobol global sampling and PCA-shaped local sampling "
        f"(local_frac={d['LOCAL_FRAC']:.2f}, local_noise={d['LOCAL_NOISE']:.3f}). "
        f"Selection used UCB, risk penalties, and shortlist decoding "
        f"(temp={d['temperature']:.2f}, top_p={d['top_p']:.2f}, top_k={d['top_k']}, best_of={d['best_of']})."
        f"{cluster_line}{pca_line} Proposed submission: {record['submission_string']}."
    )


if __name__ == "__main__":
    results, debug_all, records_all = suggest_for_all_functions(expected_n_obs=21, round_label="Round 12")

    print("\nReflection snippets:\n")
    for fid in range(1, 9):
        print(make_reflection_snippet(records_all[fid]))
        print()
